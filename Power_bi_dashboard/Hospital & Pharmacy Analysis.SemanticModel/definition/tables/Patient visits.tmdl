table 'Patient visits'
	lineageTag: 3b905766-9f67-4225-bb15-bdde87a73218

	measure 'Total Revenue' = sum(Pharmacy_Transactions[Total_Cost])
		formatString: 0
		lineageTag: 5532bf55-43f5-4ecc-9cb9-0cfff3a5859f

	measure 'Total Hospital Visits' = sum('Patient visits'[Visit_ID])
		formatString: 0
		lineageTag: bb53fe16-040f-4c7b-ab37-3177344b1789

	measure 'Average Length of days' = AVERAGE('Patient visits'[Length_of_Stay_Days])
		lineageTag: 47c9dd4c-1a51-43a0-9ed3-756783b310b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

